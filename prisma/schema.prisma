generator client {
    provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum userRoles {
    ADMIN
    USER
}
enum userStatus {
    ACTIVE
    BANNED
    DELETED
}
enum eventStatus {
   ACTIVE
   ARCHIVE
   SOLDOUT
}
model User {
    id Int @id @default(autoincrement())
    userName String @unique
    email String @unique 
    isEmailVerified Boolean @default(false)
    telegramId String? @unique 
    role userRoles @default(USER)
    status userStatus @default(ACTIVE)
    password String 
    messages Message[] 
    chats Chat [] @relation("UserChats")//Убираем
    // chatMembers ChatMember[] // Добавляем
    userImage String? 
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
}


