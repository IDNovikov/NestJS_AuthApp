generator client {
    provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum userRoles {
    ADMIN
    USER
}
enum userStatus {
    ACTIVE
    BANNED
    DELETED
}
enum eventStatus {
   ACTIVE
   ARCHIVE
   SOLDOUT
}
model User {
    id Int @id @default(autoincrement())
    userName String @unique
    email String @unique 
    isEmailVerified Boolean @default(false)
    telegramId String? @unique 
    role userRoles @default(USER)
    status userStatus @default(ACTIVE)
    password String 
    desks Desk []
    messages Message[] 
    chats Chat [] @relation("UserChats")
    userImage String? 

    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
}

model Chat {
  id       Int       @id @default(autoincrement())
  name     String?
  members User[] @relation("UserChats")
  messages Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id     String   @id @db.Uuid
  chatId   Int
  authorId Int
  text      String
  isEdited Boolean @default(false)

  chat Chat @relation(fields: [chatId], references: [id])
  author User @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chatId])
  @@index([authorId])
}

model Desk {
   id       Int       @id @default(autoincrement())
  name     String
  userId Int
  stickers Sticker[]
  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Sticker {
  id        Int      @id @default(autoincrement())
  deskId   Int
  text      String
  x         Int
  y         Int
  color     String?  @default("#ffeb3b")
  layer     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  desk Desk @relation(fields: [deskId], references: [id])

  @@index([deskId])
  @@unique([deskId, layer]) 
}